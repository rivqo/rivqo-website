# Public site URL used for metadata.
NEXT_PUBLIC_SITE_URL=https://rivqo.com

# Enquiry delivery is postponed. Leave this unset, or set it to true only
# after Resend is verified and a sending address exists.
ENQUIRY_DELIVERY_ENABLED=

# Resend. Do not commit a real key.
# Create a restricted API key after verifying rivqo.com in Resend.
RESEND_API_KEY=

# Recipient inbox.
ENQUIRY_TO_EMAIL=ola@rivqo.com

# Must be a Rivqo-owned address on a domain verified in Resend.
# Example once verified: Rivqo Website <website@rivqo.com>
ENQUIRY_FROM_EMAIL=

# Optional. Cloudflare Web Analytics token. Leave empty to keep analytics off.
# The beacon loads only in production when this value is present.
NEXT_PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=

# Optional later event analytics. Leave empty for launch.
# PostHog does not load unless this is true, its keys are set,
# and the Cloudflare token is unused.
NEXT_PUBLIC_POSTHOG_ENABLED=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Test-only. Never set in production.
# Allowed values: mock-success | mock-failure
ENQUIRY_TEST_MODE=
