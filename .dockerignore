# Source control
.git
.gitignore
.gitattributes

# Local environment files - never bake secrets into the image
.env
.env.local
.env.*.local

# Build artefacts and caches
.next
node_modules
out
build
dist
*.tsbuildinfo

# Dev tooling
.cursor
.vscode
.idea
.cache

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Docker meta
Dockerfile
.dockerignore
docker-compose*.yml

# Misc dev / repo files (not needed at runtime)
README.md
LICENSE
CHANGELOG.md
.eslintrc*
.prettierrc*
.husky

# Alternate package managers (we use npm + package-lock.json)
pnpm-lock.yaml
yarn.lock

# Test artefacts
coverage
.nyc_output
